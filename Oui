name: Build deb
on:
  push:
  workflow_dispatch:
      
permissions:
  contents: write
    
jobs:
  build:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
 
      - name: Install tools
        run: brew install ldid dpkg
 
      - name: Install Theos + SDKs
        run: |
          git clone --recursive --depth=1 https://github.com/theos/theos.git $HOME/theos
          echo "THEOS=$HOME/theos" >> $GITHUB_ENV
          git clone --depth=1 https://github.com/theos/sdks.git /tmp/sdks
          cp -R /tmp/sdks/*.sdk $HOME/theos/sdks/

      - name: Build .deb
        run: make clean package FINALPACKAGE=1

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: PiPUniversal-deb
          path: packages/*.deb

      - name: Publish release (direct .deb download)
        uses: softprops/action-gh-release@v2
        with:
          tag_name: build-${{ github.run_number }}
          files: packages/*.deb
            
